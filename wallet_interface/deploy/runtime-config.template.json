{
  "walletApi": {
    "apiBaseUrl": "${ABBY_RUNTIME_WALLET_API_BASE_URL}",
    "walletId": "${ABBY_RUNTIME_WALLET_ID}",
    "actorDid": "${ABBY_RUNTIME_ACTOR_DID}",
    "issuerKeyHex": "${ABBY_RUNTIME_ISSUER_KEY_HEX}",
    "audienceKeyHex": "${ABBY_RUNTIME_AUDIENCE_KEY_HEX}"
  },
  "filecoinStorage": {
    "uploadUrl": "${ABBY_RUNTIME_FILECOIN_UPLOAD_URL}",
    "clientToken": "${ABBY_RUNTIME_FILECOIN_CLIENT_TOKEN}"
  },
  "walrusStorage": {
    "publisherUrl": "${ABBY_RUNTIME_WALRUS_PUBLISHER_URL}",
    "aggregatorUrl": "${ABBY_RUNTIME_WALRUS_AGGREGATOR_URL}",
    "deleteUrl": "${ABBY_RUNTIME_WALRUS_DELETE_URL}",
    "clientToken": "${ABBY_RUNTIME_WALRUS_CLIENT_TOKEN}",
    "epochs": "${ABBY_RUNTIME_WALRUS_EPOCHS}",
    "deletable": "${ABBY_RUNTIME_WALRUS_DELETABLE}"
  },
  "voiceProxy": {
    "enabled": "${ABBY_RUNTIME_VOICE_PROXY_ENABLED}",
    "model": "${ABBY_RUNTIME_VOICE_PROXY_MODEL}",
    "baseUrl": "${ABBY_RUNTIME_VOICE_PROXY_BASE_URL}",
    "inferUrl": "${ABBY_RUNTIME_VOICE_PROXY_INFER_URL}",
    "ttsUrl": "${ABBY_RUNTIME_VOICE_PROXY_TTS_URL}",
    "sttUrl": "${ABBY_RUNTIME_VOICE_PROXY_STT_URL}",
    "fallbackInferUrl": "${ABBY_RUNTIME_VOICE_PROXY_FALLBACK_INFER_URL}",
    "fallbackTtsUrl": "${ABBY_RUNTIME_VOICE_PROXY_FALLBACK_TTS_URL}",
    "fallbackSttUrl": "${ABBY_RUNTIME_VOICE_PROXY_FALLBACK_STT_URL}",
    "fallbackModel": "${ABBY_RUNTIME_VOICE_PROXY_FALLBACK_MODEL}"
  },
  "agent": {
    "graphRagPrerenderMatchThreshold": "${ABBY_RUNTIME_GRAPH_RAG_PRERENDER_MATCH_THRESHOLD}"
  "worldId": {
    "enabled": "${ABBY_RUNTIME_WORLD_ID_ENABLED}",
    "appId": "${ABBY_RUNTIME_WORLD_ID_APP_ID}",
    "action": "${ABBY_RUNTIME_WORLD_ID_ACTION}",
    "environment": "${ABBY_RUNTIME_WORLD_ID_ENVIRONMENT}"
  }
}
