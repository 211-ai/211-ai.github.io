    "failClosed": false,
    "promptRedactionPolicy": "hash_only",
    "modelCommitment": "mock-model-policy@local",
    "tokenizerCommitment": "mock-tokenizer@local",
    "receiptPath": "/tmp/211-ai-llm-consensus/latest-receipt.json",
