{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://211-ai.local/schemas/world-aid/gate-0b-selection.schema.json",
  "title": "World Human Aid Gate 0B Selection Approval",
  "description": "A human-signed authorization for the narrowly scoped, offline dependency-verification wave. An unsigned template or an agent-authored record is not approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "record_id",
    "decision",
    "issued_at",
    "not_before",
    "expires_at",
    "reviewed_state",
    "execution_boundary",
    "scope",
    "reviewers",
    "exceptions",
    "trust",
    "dependency_sets",
    "security_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "world-human-aid-gate-0b-selection/v2"
    },
    "gate_id": {
      "const": "gate-0b-selection"
    },
    "record_id": {
      "type": "string",
      "pattern": "^gate-0b-selection-[a-z0-9][a-z0-9._-]{7,95}$"
    },
    "decision": {
      "const": "approved"
    },
    "issued_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "not_before": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "reviewed_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_commit",
        "submodule_commits",
        "objective_heap",
        "implementation_plan",
        "runbook",
        "storage_adr",
        "full_board",
        "objective_graph",
        "bundle_index",
        "restricted_bundle_index",
        "restricted_bundle_index_duckdb",
        "siwe_adapter",
        "siwe_proposal",
        "siwe_static_test",
        "siwe_verifier",
        "siwe_runtime_test",
        "zkp_proposal",
        "zkp_static_test",
        "zkp_verifier",
        "zkp_runtime_test",
        "zkp_smoke_spec",
        "zkp_smoke_toml",
        "zkp_smoke_lock",
        "zkp_smoke_source",
        "duckdb_verifier",
        "duckdb_runtime_test",
        "preflight_receipt",
        "gate_verifier",
        "gate_launcher",
        "gate_launcher_protocol",
        "operator_policy_template",
        "gate_receipt_verifier",
        "gate_transition_verifier",
        "gate_transition_schema",
        "gate_transition_template",
        "deployment_attestation_schema",
        "deployment_attestation_template",
        "selection_profile_builder",
        "siwe_bootstrap_runner",
        "zkp_bootstrap_runner",
        "duckdb_bootstrap_runner",
        "selection_schema",
        "selection_template"
      ],
      "properties": {
        "root_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "submodule_commits": {
          "$ref": "#/$defs/submoduleCommits"
        },
        "objective_heap": {
          "$ref": "#/$defs/artifact"
        },
        "implementation_plan": {
          "$ref": "#/$defs/artifact"
        },
        "runbook": {
          "$ref": "#/$defs/artifact"
        },
        "storage_adr": {
          "$ref": "#/$defs/artifact"
        },
        "full_board": {
          "$ref": "#/$defs/artifact"
        },
        "objective_graph": {
          "$ref": "#/$defs/artifact"
        },
        "bundle_index": {
          "$ref": "#/$defs/artifact"
        },
        "restricted_bundle_index": {
          "$ref": "#/$defs/artifact"
        },
        "restricted_bundle_index_duckdb": {
          "$ref": "#/$defs/artifact"
        },
        "siwe_adapter": {
          "$ref": "#/$defs/artifact"
        },
        "siwe_proposal": {
          "$ref": "#/$defs/artifact"
        },
        "siwe_static_test": {
          "$ref": "#/$defs/artifact"
        },
        "siwe_verifier": {
          "$ref": "#/$defs/artifact"
        },
        "siwe_runtime_test": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_proposal": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_static_test": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_verifier": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_runtime_test": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_smoke_spec": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_smoke_toml": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_smoke_lock": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_smoke_source": {
          "$ref": "#/$defs/artifact"
        },
        "duckdb_verifier": {
          "$ref": "#/$defs/artifact"
        },
        "duckdb_runtime_test": {
          "$ref": "#/$defs/artifact"
        },
        "preflight_receipt": {
          "$ref": "#/$defs/artifact"
        },
        "gate_verifier": {
          "$ref": "#/$defs/artifact"
        },
        "gate_launcher": {
          "$ref": "#/$defs/artifact"
        },
        "gate_launcher_protocol": {
          "$ref": "#/$defs/artifact"
        },
        "operator_policy_template": {
          "$ref": "#/$defs/artifact"
        },
        "gate_receipt_verifier": {
          "$ref": "#/$defs/artifact"
        },
        "gate_transition_verifier": {
          "$ref": "#/$defs/artifact"
        },
        "gate_transition_schema": {
          "$ref": "#/$defs/artifact"
        },
        "gate_transition_template": {
          "$ref": "#/$defs/artifact"
        },
        "deployment_attestation_schema": {
          "$ref": "#/$defs/artifact"
        },
        "deployment_attestation_template": {
          "$ref": "#/$defs/artifact"
        },
        "selection_profile_builder": {
          "$ref": "#/$defs/artifact"
        },
        "siwe_bootstrap_runner": {
          "$ref": "#/$defs/artifact"
        },
        "zkp_bootstrap_runner": {
          "$ref": "#/$defs/artifact"
        },
        "duckdb_bootstrap_runner": {
          "$ref": "#/$defs/artifact"
        },
        "selection_schema": {
          "$ref": "#/$defs/artifact"
        },
        "selection_template": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "execution_boundary": {
      "$ref": "#/$defs/executionBoundary"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "reviewers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "trust": {
      "$ref": "#/$defs/trust"
    },
    "dependency_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siwe",
        "zkp",
        "duckdb"
      ],
      "properties": {
        "siwe": {
          "$ref": "#/$defs/siweDependencies"
        },
        "zkp": {
          "$ref": "#/$defs/zkpDependencies"
        },
        "duckdb": {
          "$ref": "#/$defs/duckdbDependencies"
        }
      }
    },
    "security_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_deny_canary",
        "egress_policy",
        "no_live_secrets_attestation"
      ],
      "properties": {
        "network_deny_canary": {
          "$ref": "#/$defs/artifact"
        },
        "egress_policy": {
          "$ref": "#/$defs/artifact"
        },
        "no_live_secrets_attestation": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "execution_authority",
        "operation",
        "sealed_input_protocol",
        "result_protocol",
        "installed_launcher_path",
        "operator_policy_id",
        "operator_policy_sha256",
        "deployment_attestation_id",
        "deployment_attestation_sha256",
        "reviewed_artifacts"
      ],
      "properties": {
        "protocol_id": {
          "const": "world-aid-gate-first-launcher/v1"
        },
        "execution_authority": {
          "const": "operator-gate-first/v1"
        },
        "operation": {
          "const": "run-selection/v1"
        },
        "sealed_input_protocol": {
          "const": "sealed-fd-json/v1"
        },
        "result_protocol": {
          "const": "stdout-json/v1"
        },
        "installed_launcher_path": {
          "const": "/usr/local/libexec/world-aid-gate-first-launcher"
        },
        "operator_policy_id": {
          "const": "world-aid-gate-first-operator-policy/v1"
        },
        "operator_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_attestation_id": {
          "type": "string",
          "pattern": "^gate-first-deployment-[a-z0-9][a-z0-9._-]{7,95}$"
        },
        "deployment_attestation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewed_artifacts": {
          "$ref": "#/$defs/executionBoundaryArtifacts"
        }
      }
    },
    "executionBoundaryArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_verifier",
        "gate_launcher",
        "gate_launcher_protocol",
        "gate_receipt_verifier",
        "selection_profile_builder",
        "siwe_bootstrap_runner",
        "zkp_bootstrap_runner",
        "duckdb_bootstrap_runner"
      ],
      "properties": {
        "gate_verifier": {
          "$ref": "#/$defs/sha256"
        },
        "gate_launcher": {
          "$ref": "#/$defs/sha256"
        },
        "gate_launcher_protocol": {
          "$ref": "#/$defs/sha256"
        },
        "gate_receipt_verifier": {
          "$ref": "#/$defs/sha256"
        },
        "selection_profile_builder": {
          "$ref": "#/$defs/sha256"
        },
        "siwe_bootstrap_runner": {
          "$ref": "#/$defs/sha256"
        },
        "zkp_bootstrap_runner": {
          "$ref": "#/$defs/sha256"
        },
        "duckdb_bootstrap_runner": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "submoduleCommits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipfs_accelerate_py",
        "ipfs_datasets_py"
      ],
      "properties": {
        "ipfs_accelerate_py": {
          "$ref": "#/$defs/gitCommit"
        },
        "ipfs_datasets_py": {
          "$ref": "#/$defs/gitCommit"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_deny",
        "registry_access",
        "allowed_destinations"
      ],
      "properties": {
        "default_deny": {
          "const": true
        },
        "registry_access": {
          "const": false
        },
        "allowed_destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        }
      }
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "WORLD_ID_ENABLED",
        "WORLD_AID_EXTERNAL_CALLS_ENABLED",
        "WORLD_AID_WLD_TRANSFERS_ENABLED"
      ],
      "properties": {
        "WORLD_ID_ENABLED": {
          "const": "0"
        },
        "WORLD_AID_EXTERNAL_CALLS_ENABLED": {
          "const": "0"
        },
        "WORLD_AID_WLD_TRANSFERS_ENABLED": {
          "const": "0"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_ids",
        "validation_commands",
        "writable_paths",
        "network",
        "feature_flags",
        "live_secrets_present",
        "forbidden_actions"
      ],
      "properties": {
        "goal_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "WORLDCOIN-G038",
              "WORLDCOIN-G039",
              "WORLDCOIN-G040"
            ]
          }
        },
        "validation_commands": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "writable_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "feature_flags": {
          "$ref": "#/$defs/featureFlags"
        },
        "live_secrets_present": {
          "const": false
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "world-api-call",
              "chain-broadcast",
              "token-transfer",
              "contract-deployment",
              "allowance-change",
              "live-secret-access",
              "package-registry-access",
              "container-registry-access"
            ]
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identity",
        "decision",
        "reviewed_at",
        "expires_at"
      ],
      "properties": {
        "role": {
          "enum": [
            "product-owner",
            "privacy-reviewer",
            "program-policy-owner",
            "accessibility-reviewer",
            "repository-maintainer",
            "supply-chain-maintainer",
            "cryptography-reviewer",
            "storage-security-reviewer",
            "security-reviewer"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9@._+-]+$"
        },
        "decision": {
          "const": "approved"
        },
        "reviewed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "rationale",
        "compensating_controls",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EX-[A-Z0-9][A-Z0-9_-]{2,31}$"
        },
        "owner": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "compensating_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        },
        "expires_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identity",
        "key_fingerprint",
        "file"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "identity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}\\.sshsig$"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_namespace",
        "allowed_signers_sha256",
        "signatures"
      ],
      "properties": {
        "signature_namespace": {
          "const": "world-aid-gate-0b-selection-v2"
        },
        "allowed_signers_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signatures": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/signature"
          }
        }
      }
    },
    "readOnlyDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "read_only"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "read_only": {
          "const": true
        }
      }
    },
    "siweDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_toolchain",
        "manifest",
        "lockfile",
        "tarballs",
        "cache",
        "licenses",
        "provenance",
        "sbom",
        "vulnerability_review",
        "lifecycle_scripts"
      ],
      "properties": {
        "runtime_toolchain": {
          "$ref": "#/$defs/siweRuntimeToolchain"
        },
        "manifest": {
          "$ref": "#/$defs/artifact"
        },
        "lockfile": {
          "$ref": "#/$defs/artifact"
        },
        "tarballs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "cache": {
          "$ref": "#/$defs/siweReadOnlyCache"
        },
        "licenses": {
          "$ref": "#/$defs/artifact"
        },
        "provenance": {
          "$ref": "#/$defs/artifact"
        },
        "sbom": {
          "$ref": "#/$defs/artifact"
        },
        "vulnerability_review": {
          "$ref": "#/$defs/artifact"
        },
        "lifecycle_scripts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "siweReadOnlyCache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "read_only",
        "tree_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "read_only": {
          "const": true
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "siweRuntimeToolchainMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "siweRuntimeToolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "archive_format",
        "archive",
        "root",
        "node",
        "npm_cli"
      ],
      "properties": {
        "platform": {
          "const": "linux"
        },
        "architecture": {
          "type": "string",
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "archive_format": {
          "const": "tar.xz"
        },
        "archive": {
          "$ref": "#/$defs/artifact"
        },
        "root": {
          "$ref": "#/$defs/relativePath"
        },
        "node": {
          "$ref": "#/$defs/siweRuntimeToolchainMember"
        },
        "npm_cli": {
          "$ref": "#/$defs/siweRuntimeToolchainMember"
        }
      }
    },
    "zkpDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "backend",
        "version",
        "tool",
        "smoke_spec",
        "smoke_toml",
        "smoke_source",
        "smoke_lock",
        "licenses",
        "provenance",
        "sbom",
        "vulnerability_review",
        "deterministic_flags",
        "resource_bounds"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool": {
          "$ref": "#/$defs/artifact"
        },
        "smoke_spec": {
          "$ref": "#/$defs/artifact"
        },
        "smoke_toml": {
          "$ref": "#/$defs/artifact"
        },
        "smoke_source": {
          "$ref": "#/$defs/artifact"
        },
        "smoke_lock": {
          "$ref": "#/$defs/artifact"
        },
        "licenses": {
          "$ref": "#/$defs/artifact"
        },
        "provenance": {
          "$ref": "#/$defs/artifact"
        },
        "sbom": {
          "$ref": "#/$defs/artifact"
        },
        "vulnerability_review": {
          "$ref": "#/$defs/artifact"
        },
        "deterministic_flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "resource_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_seconds",
            "max_memory_mb",
            "max_output_bytes"
          ],
          "properties": {
            "max_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "max_memory_mb": {
              "type": "integer",
              "minimum": 64,
              "maximum": 65536
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            }
          }
        }
      }
    },
    "duckdbDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "platform",
        "duckdb_version",
        "wheels",
        "wheelhouse",
        "requirements_lock",
        "runtime_policy",
        "backup_policy",
        "licenses",
        "provenance",
        "sbom",
        "vulnerability_review",
        "topology",
        "database_file_encryption",
        "extension_auto_install",
        "extension_auto_load",
        "external_access",
        "community_extensions",
        "extension_directory"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "platform": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "duckdb_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.]+)?$"
        },
        "wheels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "wheelhouse": {
          "$ref": "#/$defs/readOnlyDirectory"
        },
        "requirements_lock": {
          "$ref": "#/$defs/artifact"
        },
        "runtime_policy": {
          "$ref": "#/$defs/artifact"
        },
        "backup_policy": {
          "$ref": "#/$defs/artifact"
        },
        "licenses": {
          "$ref": "#/$defs/artifact"
        },
        "provenance": {
          "$ref": "#/$defs/artifact"
        },
        "sbom": {
          "$ref": "#/$defs/artifact"
        },
        "vulnerability_review": {
          "$ref": "#/$defs/artifact"
        },
        "topology": {
          "const": "single-host-single-writer-coordinator"
        },
        "database_file_encryption": {
          "const": "encrypted-volume-plus-application-envelope-encryption"
        },
        "extension_auto_install": {
          "const": false
        },
        "extension_auto_load": {
          "const": false
        },
        "external_access": {
          "const": false
        },
        "community_extensions": {
          "const": false
        },
        "extension_directory": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "path",
                "allowlist"
              ],
              "properties": {
                "mode": {
                  "const": "disabled"
                },
                "path": {
                  "const": ""
                },
                "allowlist": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "path",
                "allowlist"
              ],
              "properties": {
                "mode": {
                  "const": "allowlist"
                },
                "path": {
                  "$ref": "#/$defs/relativePath"
                },
                "allowlist": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "path": {
                        "$ref": "#/$defs/relativePath"
                      },
                      "sha256": {
                        "$ref": "#/$defs/sha256"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
