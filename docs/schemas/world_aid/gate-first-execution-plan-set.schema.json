{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://211-ai.local/schemas/world-aid/gate-first-execution-plan-set.schema.json",
  "title": "World Aid Gate-first Candidate Execution Plan Set",
  "description": "Structural schema for a validation-only v2 candidate profile. Its digest must arrive through a separately authenticated external channel because current Gate selection v2, operator policy v1, and deployment attestation v1 do not bind it. Relational, canonical-byte, and native-constructor invariants are additionally enforced by scripts/build_world_aid_gate_first_execution_plans.py. This document never grants runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "status",
    "candidate_validation_enabled",
    "runtime_authorized",
    "contract",
    "authority",
    "protocol",
    "plans"
  ],
  "properties": {
    "schema": {
      "const": "world-aid-gate-first-execution-plan-set/v2"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^gate-first-execution-plans-[a-z0-9][a-z0-9._-]{7,95}$"
    },
    "status": {
      "const": "candidate-ready-for-external-authentication"
    },
    "candidate_validation_enabled": {
      "const": true
    },
    "runtime_authorized": {
      "const": false
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "plans": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/g038Plan"
        },
        {
          "$ref": "#/$defs/g039Plan"
        },
        {
          "$ref": "#/$defs/g040Plan"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000-\\u001f\\u007f]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000-\\u001f\\u007f]+$"
    },
    "positiveBound": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "builder_path",
        "builder_sha256",
        "schema_path",
        "schema_sha256",
        "transport_codec_path",
        "transport_codec_sha256",
        "transport_input_schema_path",
        "transport_input_schema_sha256",
        "transport_result_schema_path",
        "transport_result_schema_sha256",
        "transport_spec_path",
        "transport_spec_sha256",
        "receipt_verifier_path",
        "receipt_verifier_sha256"
      ],
      "properties": {
        "contract_id": {
          "const": "world-aid-gate-first-plan-construction/v2"
        },
        "builder_path": {
          "const": "scripts/build_world_aid_gate_first_execution_plans.py"
        },
        "builder_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_path": {
          "const": "docs/schemas/world_aid/gate-first-execution-plan-set.schema.json"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transport_codec_path": {
          "const": "scripts/world_aid_runner_transport_v2.py"
        },
        "transport_codec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transport_input_schema_path": {
          "const": "docs/schemas/world_aid/runner-transport-v2-input.schema.json"
        },
        "transport_input_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transport_result_schema_path": {
          "const": "docs/schemas/world_aid/runner-transport-v2-result.schema.json"
        },
        "transport_result_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transport_spec_path": {
          "const": "docs/specs/WORLD_AID_RUNNER_TRANSPORT_V2.md"
        },
        "transport_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_verifier_path": {
          "const": "scripts/verify_world_aid_gate_first_receipt.py"
        },
        "receipt_verifier_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_approval",
        "operator_policy",
        "deployment_attestation"
      ],
      "properties": {
        "selection_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "record_id",
            "sha256"
          ],
          "properties": {
            "schema": {
              "const": "world-human-aid-gate-0b-selection/v2"
            },
            "record_id": {
              "type": "string",
              "pattern": "^gate-0b-selection-[a-z0-9][a-z0-9._-]{7,95}$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "operator_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sha256"
          ],
          "properties": {
            "schema": {
              "const": "world-aid-gate-first-operator-policy/v1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "deployment_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "attestation_id",
            "sha256"
          ],
          "properties": {
            "schema": {
              "const": "world-aid-gate-first-deployment-conformance-attestation/v1"
            },
            "attestation_id": {
              "type": "string",
              "pattern": "^gate-first-deployment-[a-z0-9][a-z0-9._-]{7,95}$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_protocol_id",
        "execution_authority",
        "operation",
        "transport_protocol_id",
        "input_schema",
        "input_protocol",
        "result_schema",
        "output_protocol"
      ],
      "properties": {
        "gate_protocol_id": {
          "const": "world-aid-gate-first-launcher/v1"
        },
        "execution_authority": {
          "const": "operator-gate-first/v1"
        },
        "operation": {
          "const": "run-selection/v1"
        },
        "transport_protocol_id": {
          "const": "world-aid-runner-transport/v2"
        },
        "input_schema": {
          "const": "world-human-aid-runner-input-envelope/v2"
        },
        "input_protocol": {
          "const": "sealed-fd-json/v2"
        },
        "result_schema": {
          "const": "world-human-aid-runner-result-envelope/v2"
        },
        "output_protocol": {
          "const": "stdout-json/v2"
        }
      }
    },
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "sha256",
        "max_bytes",
        "version"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "sha256",
        "max_bytes",
        "workspace_relative_path"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "workspace_relative_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "boundArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "sha256",
        "size"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "g038Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "runner_path",
        "runner_sha256",
        "native_plan_schema",
        "canonicalization",
        "native_plan_sha256",
        "network_boundary_attestation_sha256",
        "plan_payload"
      ],
      "properties": {
        "goal_id": {
          "const": "WORLDCOIN-G038"
        },
        "runner_path": {
          "const": "scripts/run_world_aid_siwe_bootstrap.py"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_plan_schema": {
          "const": "world-human-aid-g038-siwe-offline-plan/v1"
        },
        "canonicalization": {
          "const": "sorted-compact-utf8-lf/v1"
        },
        "native_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "network_boundary_attestation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_payload": {
          "$ref": "#/$defs/g038Payload"
        }
      }
    },
    "g039Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "runner_path",
        "runner_sha256",
        "native_plan_schema",
        "canonicalization",
        "native_plan_sha256",
        "network_boundary_attestation_sha256",
        "plan_payload"
      ],
      "properties": {
        "goal_id": {
          "const": "WORLDCOIN-G039"
        },
        "runner_path": {
          "const": "scripts/run_world_aid_zkp_bootstrap.py"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_plan_schema": {
          "const": "world-human-aid-g039-native-smoke-plan/v1"
        },
        "canonicalization": {
          "const": "sorted-compact-utf8-lf/v1"
        },
        "native_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "network_boundary_attestation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_payload": {
          "$ref": "#/$defs/g039Payload"
        }
      }
    },
    "g040Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "runner_path",
        "runner_sha256",
        "native_plan_schema",
        "canonicalization",
        "native_plan_sha256",
        "network_boundary_attestation_sha256",
        "plan_payload"
      ],
      "properties": {
        "goal_id": {
          "const": "WORLDCOIN-G040"
        },
        "runner_path": {
          "const": "scripts/run_world_aid_duckdb_bootstrap.py"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_plan_schema": {
          "const": "world-human-aid-g040-duckdb-bootstrap-plan/v1"
        },
        "canonicalization": {
          "const": "sorted-compact-ascii-lf/v1"
        },
        "native_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "network_boundary_attestation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_payload": {
          "$ref": "#/$defs/g040Payload"
        }
      }
    },
    "g038Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "goal_id",
        "authorization_sha256",
        "selection_record_id",
        "network_policy",
        "network_boundary",
        "platform",
        "architecture",
        "toolchain_archive_sha256",
        "node",
        "npm_cli",
        "manifest",
        "lockfile",
        "adapter",
        "smoke_source",
        "cache",
        "resource_bounds",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "const": "world-human-aid-g038-siwe-offline-plan/v1"
        },
        "goal_id": {
          "const": "WORLDCOIN-G038"
        },
        "authorization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selection_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 112,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
        },
        "network_policy": {
          "const": "external-deny-all"
        },
        "network_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attestation_sha256",
            "namespace",
            "apparmor_profile",
            "network_deny_canary_sha256",
            "egress_policy_sha256"
          ],
          "properties": {
            "attestation_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^net:\\[[0-9]+\\]$"
            },
            "apparmor_profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": " \\(enforce\\)$"
            },
            "network_deny_canary_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "egress_policy_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
        },
        "toolchain_archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "node": {
          "$ref": "#/$defs/toolBinding"
        },
        "npm_cli": {
          "$ref": "#/$defs/toolBinding"
        },
        "manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/inputBinding"
            },
            {
              "properties": {
                "workspace_relative_path": {
                  "const": "package.json"
                }
              }
            }
          ]
        },
        "lockfile": {
          "allOf": [
            {
              "$ref": "#/$defs/inputBinding"
            },
            {
              "properties": {
                "workspace_relative_path": {
                  "const": "package-lock.json"
                }
              }
            }
          ]
        },
        "adapter": {
          "allOf": [
            {
              "$ref": "#/$defs/inputBinding"
            },
            {
              "properties": {
                "workspace_relative_path": {
                  "const": "index.mjs"
                }
              }
            }
          ]
        },
        "smoke_source": {
          "allOf": [
            {
              "$ref": "#/$defs/inputBinding"
            },
            {
              "properties": {
                "workspace_relative_path": {
                  "const": "g038-smoke.mjs"
                }
              }
            }
          ]
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_path",
            "sha256",
            "max_archive_bytes",
            "archive_format",
            "max_entries",
            "max_extracted_bytes",
            "tree_sha256",
            "entries"
          ],
          "properties": {
            "source_path": {
              "$ref": "#/$defs/absolutePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "max_archive_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967296
            },
            "archive_format": {
              "const": "tar"
            },
            "max_entries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            "max_extracted_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967296
            },
            "tree_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200000,
              "items": {
                "$ref": "#/$defs/g038CacheEntry"
              }
            }
          }
        },
        "resource_bounds": {
          "$ref": "#/$defs/g038Bounds"
        },
        "expires_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "g039Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "goal_id",
        "authorization_sha256",
        "network_boundary_sha256",
        "network_policy",
        "tool_path",
        "tool_sha256",
        "tool_max_bytes",
        "build_a_argv",
        "build_b_argv",
        "prove_argv",
        "verify_argv",
        "fixed_env",
        "inputs",
        "resource_bounds",
        "artifact_relative_path",
        "proof_relative_path",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "const": "world-human-aid-g039-native-smoke-plan/v1"
        },
        "goal_id": {
          "const": "WORLDCOIN-G039"
        },
        "authorization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "network_boundary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "network_policy": {
          "const": "external-deny-all"
        },
        "tool_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "build_a_argv": {
          "$ref": "#/$defs/g039BuildArgv"
        },
        "build_b_argv": {
          "$ref": "#/$defs/g039BuildArgv"
        },
        "prove_argv": {
          "$ref": "#/$defs/g039ProofArgv"
        },
        "verify_argv": {
          "$ref": "#/$defs/g039ProofArgv"
        },
        "fixed_env": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              {
                "type": "string",
                "maxLength": 4096
              }
            ],
            "items": false
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/g039InputBinding"
          }
        },
        "resource_bounds": {
          "$ref": "#/$defs/g039Bounds"
        },
        "artifact_relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "proof_relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "expires_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "g040Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "goal_id",
        "authorization",
        "network_boundary_attestation",
        "network_policy",
        "python",
        "wheel",
        "requirements_lock",
        "runtime_policy",
        "backup_policy",
        "storage_adr",
        "smoke_bootstrap_sha256",
        "resource_bounds",
        "run_directory",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "const": "world-human-aid-g040-duckdb-bootstrap-plan/v1"
        },
        "goal_id": {
          "const": "WORLDCOIN-G040"
        },
        "authorization": {
          "$ref": "#/$defs/boundArtifact"
        },
        "network_boundary_attestation": {
          "$ref": "#/$defs/boundArtifact"
        },
        "network_policy": {
          "const": "external-deny-all"
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size",
            "version"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/absolutePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size",
            "filename",
            "duckdb_version",
            "python_tag",
            "abi_tag",
            "platform_tag"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/absolutePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483648
            },
            "filename": {
              "type": "string",
              "pattern": "^duckdb-[0-9]+(?:\\.[0-9]+){2,3}-cp[0-9]{2,3}-cp[0-9]{2,3}[a-z0-9_]*-[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*\\.whl$"
            },
            "duckdb_version": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$"
            },
            "python_tag": {
              "type": "string",
