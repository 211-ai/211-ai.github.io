# Restrict Docker build contexts to the code paths used by the wallet stack.
*
!.dockerignore
!ipfs_datasets_py/
!ipfs_accelerate_py/
!wallet_interface/

# Drop generated caches and dependency trees inside the included directories.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.hypothesis/
**/.venv/
**/node_modules/
**/dist/
**/build/
**/.vite/
**/coverage/
**/playwright-report/
**/test-results/

# Drop local deployment outputs that are never copied into images.
wallet_interface/ui/artifacts/

# Drop vendored tooling and backups that are not used by the wallet service images.
ipfs_datasets_py/.tools/
ipfs_datasets_py/.codex/
ipfs_datasets_py/.github/
ipfs_datasets_py/.vscode/
ipfs_datasets_py/archive/
ipfs_datasets_py/artifacts/
ipfs_datasets_py/benchmarks/
ipfs_datasets_py/deployments/
ipfs_datasets_py/docs/
ipfs_datasets_py/examples/
ipfs_datasets_py/ipfs_datasets_py/processors/groth16_backend/
ipfs_datasets_py/tests/
ipfs_datasets_py/tmp/
ipfs_datasets_py/workspace/

# The wallet API installs the sibling ipfs_accelerate_py checkout for its
# package-owned voice router. Keep that source in the build context while
# excluding development corpora, tests, browser assets, and the optional
# Qualcomm SDK payload that the remote Publicus voice path never imports.
ipfs_accelerate_py/.codex/
ipfs_accelerate_py/.github/
ipfs_accelerate_py/.git
ipfs_accelerate_py/.vscode/
ipfs_accelerate_py/artifacts/
ipfs_accelerate_py/data/
ipfs_accelerate_py/docs/
ipfs_accelerate_py/ipfs_accelerate_js/
ipfs_accelerate_py/ipfs_accelerate_py/utils/qualcomm/
ipfs_accelerate_py/test/
ipfs_accelerate_py/tmp/
